struct RegisteredHeader {
    generation: u32,
    revision: u32,
    render_class: u32,
    render_domain: u32,
    feature_flags: u32,
    closure_mask: u32,
    parameter_offset: u32,
    parameter_size: u32,
    texture_offset: u32,
    texture_count: u32,
    sampler_offset: u32,
    sampler_count: u32,
    is_active: u32,
