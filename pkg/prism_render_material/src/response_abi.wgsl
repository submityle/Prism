struct RegisteredEnvironment {
    ambient: vec3<f32>,
    directional_count: u32,
    sh: array<vec4<f32>, 9>,
    punctual_count: u32,
    reserved0: u32,
    exposure: f32,
    flags: u32,
    stylized: RegisteredStylizedParams,
}

