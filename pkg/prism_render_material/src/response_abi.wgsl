    specular_color: vec3<f32>,
    rim_intensity: f32,
    rim_color: vec3<f32>,
    rim_power: f32,
}

struct RegisteredLight {
    direction: vec3<f32>,
    illuminance: vec3<f32>,
    visibility: f32,
    valid: f32,
}

struct RegisteredArea {
    pos_x: f32,
    pos_y: f32,
    pos_z: f32,
    range: f32,
    color_x: f32,
    color_y: f32,
    color_z: f32,
    intensity: f32,
    axis_u_x: f32,
    axis_u_y: f32,
    axis_u_z: f32,
    half_width: f32,
    axis_v_x: f32,
    axis_v_y: f32,
    axis_v_z: f32,
    half_height: f32,
    shape: u32,
    two_sided: u32,
    radius: f32,
    pad0: u32,
}

// v1 function-link ABI. RGB words: direct, indirect diffuse, reflection,
// transmission, emission; word 15 is alpha. No builtin BSDF is implicit.
struct RegisteredResponse {
    direct: vec3<f32>,
    indirect_diffuse: vec3<f32>,
    reflection: vec3<f32>,
    transmission: vec3<f32>,
    emission: vec3<f32>,
    alpha: f32,
}
struct RegisteredSurfaceData {
    sample: RegisteredSurface,
    frame: RegisteredFrame,
    geometry: RegisteredGeometry,
    parameters: RegisteredParameters,
}
struct RegisteredLightingContext {
    environment: RegisteredEnvironment,
    frame: RegisteredFrame,
    world_position: vec3<f32>,
    directional_count: u32,
    punctual_count: u32,
    area_count: u32,
    clustered: u32,
    cluster_offset: u32,
    indirect_total: vec3<f32>,
    diffuse_irradiance: vec3<f32>,
    environment_radiance: vec3<f32>,
    specular_weight: vec3<f32>,
}
struct RegisteredView {
    position: vec3<f32>,
    pixel: vec2<u32>,
    size: vec2<u32>,
    frame_index: u32,
    clip_from_world: mat4x4<f32>,
    previous_clip_from_world: mat4x4<f32>,
}
struct RegisteredCustomData {
    header: RegisteredHeader,
    permutation_low: u32,
    permutation_high: u32,
}
