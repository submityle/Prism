//! DO NOT EDIT — generated by `prism-material-codegen` from schema/surface.toml.
//! Regenerate: cargo run -p prism_material_schema --bin prism-material-codegen -- write
//!
//! Variable-length material parameter word-heap decode (design doc §3.3 / §17.5).
//!
//! Byte-exact WESL twin of
//! `prism_render_material::SurfaceParameterBlock::unpack(mask, words).to_full()`:
//! the scene packs each surface as an über-BSDF core (20 words) followed by
//! only the lobes named in `lobe_mask`, written low bit first. Readers gather the
//! material's `parameter_size / 4` words out of the shared `array<u32>` heap into a
//! fixed `array<u32, 96>` (the fully-loaded worst case) and expand them back to
//! a full `PrismSurfaceParameters`, filling absent lobes with neutral defaults.
//!
//! Kept as a single generated source so all five consumers (opaque, transparent,
//! visibility, shading_resolve, ssr_repack) decode identically.

import prism_render_scene::shaders::material::PrismSurfaceParameters;

const PRISM_LOBE_EMISSION: u32 = 1u;      // 1 << 0
const PRISM_LOBE_CLEARCOAT: u32 = 2u;     // 1 << 1
const PRISM_LOBE_ANISOTROPY: u32 = 4u;    // 1 << 2
const PRISM_LOBE_SHEEN: u32 = 8u;         // 1 << 3
const PRISM_LOBE_SUBSURFACE: u32 = 16u;   // 1 << 4
const PRISM_LOBE_TRANSMISSION: u32 = 32u; // 1 << 5
const PRISM_LOBE_THIN_FILM: u32 = 64u;    // 1 << 6
const PRISM_LOBE_NPR_FACE: u32 = 65536u;  // 1 << 16
const PRISM_LOBE_ALL: u32 = 65663u;       // (1 << 8) - 1

const PRISM_SURFACE_CORE_WORDS: u32 = 20u;
/// Widest per-lobe word footprint (a documentation constant; the pack cursor
/// advances by each lobe's own `PRISM_LOBE_WORDS_*`, never this value).
const PRISM_SURFACE_LOBE_WORDS: u32 = 16u;

// Per-lobe word footprints (variable length, §4.4). The decoder advances a
// cursor by exactly the present lobe's footprint, so lobes may differ in size.
const PRISM_LOBE_WORDS_EMISSION: u32 = 8u;
const PRISM_LOBE_WORDS_CLEARCOAT: u32 = 16u;
const PRISM_LOBE_WORDS_ANISOTROPY: u32 = 4u;
const PRISM_LOBE_WORDS_SHEEN: u32 = 8u;
const PRISM_LOBE_WORDS_SUBSURFACE: u32 = 16u;
const PRISM_LOBE_WORDS_TRANSMISSION: u32 = 16u;
const PRISM_LOBE_WORDS_THIN_FILM: u32 = 4u;
const PRISM_LOBE_WORDS_NPR_FACE: u32 = 4u;

/// Fully-loaded worst case: core + every lobe (20 + sum of 8 lobe footprints).
const PRISM_SURFACE_MAX_WORDS: u32 = 96u;

/// Packed word count for a mask: core plus each present lobe's own footprint.
/// Mirrors `SurfaceParameterBlock::packed_len_words`.
fn prism_packed_word_count(lobe_mask: u32) -> u32 {
    var words: u32 = PRISM_SURFACE_CORE_WORDS;
    if ((lobe_mask & PRISM_LOBE_EMISSION) != 0u) { words += PRISM_LOBE_WORDS_EMISSION; }
    if ((lobe_mask & PRISM_LOBE_CLEARCOAT) != 0u) { words += PRISM_LOBE_WORDS_CLEARCOAT; }
    if ((lobe_mask & PRISM_LOBE_ANISOTROPY) != 0u) { words += PRISM_LOBE_WORDS_ANISOTROPY; }
    if ((lobe_mask & PRISM_LOBE_SHEEN) != 0u) { words += PRISM_LOBE_WORDS_SHEEN; }
    if ((lobe_mask & PRISM_LOBE_SUBSURFACE) != 0u) { words += PRISM_LOBE_WORDS_SUBSURFACE; }
    if ((lobe_mask & PRISM_LOBE_TRANSMISSION) != 0u) { words += PRISM_LOBE_WORDS_TRANSMISSION; }
    if ((lobe_mask & PRISM_LOBE_THIN_FILM) != 0u) { words += PRISM_LOBE_WORDS_THIN_FILM; }
    if ((lobe_mask & PRISM_LOBE_NPR_FACE) != 0u) { words += PRISM_LOBE_WORDS_NPR_FACE; }
    return words;
}

/// The canonical neutral surface (`GpuSurfaceParameters::default`): the base an
/// absent lobe decodes back to, and the value returned when a material's declared
/// range does not fit the bound heap.
fn prism_neutral_surface() -> PrismSurfaceParameters {
    var s: PrismSurfaceParameters;
    s.base_color = vec4<f32>(0.8, 0.8, 0.8, 1.0);
    s.base_metalness = 0.0;
    s.specular_roughness = 0.3;
    s.specular_weight = 1.0;
    s.ambient_occlusion = 1.0;
    s.normal_scale = 1.0;
    s.alpha_cutoff = 0.5;
    s.base_weight = 1.0;
    s.base_diffuse_roughness = 0.0;
    s.specular_color = vec4<f32>(1.0, 1.0, 1.0, 1.0);
    s.specular_ior = 1.5;
    s.thin_walled = 0.0;
    s.geometry_opacity = 1.0;
    s.emission_color = vec4<f32>(1.0, 1.0, 1.0, 1.0);
    s.emission_luminance = 0.0;
    s.coat_weight = 0.0;
    s.coat_roughness = 0.0;
    s.coat_ior = 1.6;
    s.coat_color = vec4<f32>(1.0, 1.0, 1.0, 1.0);
    s.coat_roughness_anisotropy = 0.0;
    s.coat_darkening = 1.0;
    s.anisotropy = 0.0;
    s.anisotropy_rotation = 0.0;
    s.fuzz_weight = 0.0;
    s.fuzz_roughness = 0.5;
    s.fuzz_color = vec4<f32>(1.0, 1.0, 1.0, 1.0);
    s.subsurface_weight = 0.0;
    s.subsurface_radius = 1.0;
    s.subsurface_color = vec4<f32>(0.8, 0.8, 0.8, 1.0);
    s.subsurface_radius_scale = vec4<f32>(1.0, 0.5, 0.25, 1.0);
    s.subsurface_scatter_anisotropy = 0.0;
    s.transmission_weight = 0.0;
    s.thickness = 0.0;
    s.index_of_refraction = 1.5;
    s.transmission_dispersion_scale = 0.0;
    s.transmission_color = vec4<f32>(1.0, 1.0, 1.0, 1.0);
    s.transmission_scatter = vec4<f32>(0.0, 0.0, 0.0, 1.0);
    s.transmission_scatter_anisotropy = 0.0;
    s.transmission_dispersion_abbe_number = 20.0;
    s.thin_film_weight = 0.0;
    s.thin_film_thickness = 0.5;
    s.thin_film_ior = 1.4;
    s.npr_face_softness = 0.1;
    return s;
}

/// Expand `words` (a material's packed block, low words first) into a full surface
/// using `lobe_mask`. Words beyond the packed length are ignored; absent lobes keep
/// their neutral default. Byte-exact twin of
/// `SurfaceParameterBlock::unpack(mask, words).to_full()`.
fn prism_unpack_surface(words: array<u32, 96>, lobe_mask: u32) -> PrismSurfaceParameters {
    var w = words;
    var s = prism_neutral_surface();

    // Core (20 words); w[19] are padding.
    s.base_color = vec4<f32>(
        bitcast<f32>(w[0]),
        bitcast<f32>(w[1]),
        bitcast<f32>(w[2]),
        bitcast<f32>(w[3]),
    );
    s.base_metalness = bitcast<f32>(w[4]);
    s.specular_roughness = bitcast<f32>(w[5]);
    s.specular_weight = bitcast<f32>(w[6]);
    s.ambient_occlusion = bitcast<f32>(w[7]);
    s.normal_scale = bitcast<f32>(w[8]);
    s.alpha_cutoff = bitcast<f32>(w[9]);
    s.base_weight = bitcast<f32>(w[10]);
    s.base_diffuse_roughness = bitcast<f32>(w[11]);
    s.specular_color = vec4<f32>(
        bitcast<f32>(w[12]),
        bitcast<f32>(w[13]),
        bitcast<f32>(w[14]),
        bitcast<f32>(w[15]),
    );
    s.specular_ior = bitcast<f32>(w[16]);
    s.thin_walled = bitcast<f32>(w[17]);
    s.geometry_opacity = bitcast<f32>(w[18]);

    // Present lobes, canonical low-bit-first order, each its own footprint.
    var cursor: u32 = PRISM_SURFACE_CORE_WORDS;
    if (lobe_mask & PRISM_LOBE_EMISSION) != 0u {
        s.emission_color = vec4<f32>(
            bitcast<f32>(w[cursor]),
            bitcast<f32>(w[cursor + 1u]),
            bitcast<f32>(w[cursor + 2u]),
            bitcast<f32>(w[cursor + 3u]),
        );
        s.emission_luminance = bitcast<f32>(w[cursor + 4u]);
        cursor += PRISM_LOBE_WORDS_EMISSION;
    }
    if (lobe_mask & PRISM_LOBE_CLEARCOAT) != 0u {
        s.coat_weight = bitcast<f32>(w[cursor]);
        s.coat_roughness = bitcast<f32>(w[cursor + 1u]);
        s.coat_ior = bitcast<f32>(w[cursor + 2u]);
        s.coat_color = vec4<f32>(
            bitcast<f32>(w[cursor + 4u]),
            bitcast<f32>(w[cursor + 5u]),
            bitcast<f32>(w[cursor + 6u]),
            bitcast<f32>(w[cursor + 7u]),
        );
        s.coat_roughness_anisotropy = bitcast<f32>(w[cursor + 8u]);
        s.coat_darkening = bitcast<f32>(w[cursor + 12u]);
        cursor += PRISM_LOBE_WORDS_CLEARCOAT;
    }
    if (lobe_mask & PRISM_LOBE_ANISOTROPY) != 0u {
        s.anisotropy = bitcast<f32>(w[cursor]);
        s.anisotropy_rotation = bitcast<f32>(w[cursor + 1u]);
        cursor += PRISM_LOBE_WORDS_ANISOTROPY;
    }
    if (lobe_mask & PRISM_LOBE_SHEEN) != 0u {
        s.fuzz_weight = bitcast<f32>(w[cursor]);
        s.fuzz_roughness = bitcast<f32>(w[cursor + 1u]);
        s.fuzz_color = vec4<f32>(
            bitcast<f32>(w[cursor + 4u]),
            bitcast<f32>(w[cursor + 5u]),
            bitcast<f32>(w[cursor + 6u]),
            bitcast<f32>(w[cursor + 7u]),
        );
        cursor += PRISM_LOBE_WORDS_SHEEN;
    }
    if (lobe_mask & PRISM_LOBE_SUBSURFACE) != 0u {
        s.subsurface_weight = bitcast<f32>(w[cursor]);
        s.subsurface_radius = bitcast<f32>(w[cursor + 2u]);
        s.subsurface_color = vec4<f32>(
            bitcast<f32>(w[cursor + 4u]),
            bitcast<f32>(w[cursor + 5u]),
            bitcast<f32>(w[cursor + 6u]),
            bitcast<f32>(w[cursor + 7u]),
        );
        s.subsurface_radius_scale = vec4<f32>(
            bitcast<f32>(w[cursor + 8u]),
            bitcast<f32>(w[cursor + 9u]),
            bitcast<f32>(w[cursor + 10u]),
            bitcast<f32>(w[cursor + 11u]),
        );
        s.subsurface_scatter_anisotropy = bitcast<f32>(w[cursor + 12u]);
        cursor += PRISM_LOBE_WORDS_SUBSURFACE;
    }
    if (lobe_mask & PRISM_LOBE_TRANSMISSION) != 0u {
        s.transmission_weight = bitcast<f32>(w[cursor]);
        s.thickness = bitcast<f32>(w[cursor + 1u]);
        s.index_of_refraction = bitcast<f32>(w[cursor + 2u]);
        s.transmission_dispersion_scale = bitcast<f32>(w[cursor + 3u]);
        s.transmission_color = vec4<f32>(
            bitcast<f32>(w[cursor + 4u]),
            bitcast<f32>(w[cursor + 5u]),
            bitcast<f32>(w[cursor + 6u]),
            bitcast<f32>(w[cursor + 7u]),
        );
        s.transmission_scatter = vec4<f32>(
            bitcast<f32>(w[cursor + 8u]),
            bitcast<f32>(w[cursor + 9u]),
            bitcast<f32>(w[cursor + 10u]),
            bitcast<f32>(w[cursor + 11u]),
        );
        s.transmission_scatter_anisotropy = bitcast<f32>(w[cursor + 12u]);
        s.transmission_dispersion_abbe_number = bitcast<f32>(w[cursor + 13u]);
        cursor += PRISM_LOBE_WORDS_TRANSMISSION;
    }
    if (lobe_mask & PRISM_LOBE_THIN_FILM) != 0u {
        s.thin_film_weight = bitcast<f32>(w[cursor]);
        s.thin_film_thickness = bitcast<f32>(w[cursor + 1u]);
        s.thin_film_ior = bitcast<f32>(w[cursor + 2u]);
        cursor += PRISM_LOBE_WORDS_THIN_FILM;
    }
    if (lobe_mask & PRISM_LOBE_NPR_FACE) != 0u {
        s.npr_face_softness = bitcast<f32>(w[cursor]);
        cursor += PRISM_LOBE_WORDS_NPR_FACE;
    }
    return s;
}
